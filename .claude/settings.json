    "PostToolUse": [
      {"matcher": ".*", "hooks": [{"type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/bin/hook-dispatch.sh\" PostToolUse"}]}
    ],
    "Stop": [
      {"matcher": "", "hooks": [{"type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/bin/hook-dispatch.sh\" Stop"}]}
    ],
    "InstructionsLoaded": [
      {"matcher": "", "hooks": [{"type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/bin/hook-dispatch.sh\" InstructionsLoaded"}]}
    ]
  }
