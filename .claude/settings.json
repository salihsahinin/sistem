    ],
    "UserPromptSubmit": [
      {"matcher": "", "hooks": [{"type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/bin/hook-dispatch.sh\" UserPromptSubmit"}]}
    ],
    "PreToolUse": [
      {"matcher": ".*", "hooks": [{"type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/bin/hook-dispatch.sh\" PreToolUse"}]}
