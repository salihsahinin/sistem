{
  "permissions": {
    "deny": [
      "Edit(wiki/sozluk.md)",
      "Write(wiki/sozluk.md)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(screencapture:*)",
      "Bash(rec:*)",
      "Bash(sox:*)",
      "Edit(core/tuzuk-v0.md)",
      "Write(core/tuzuk-v0.md)",
      "Edit(CLAUDE.md)",
      "Write(CLAUDE.md)",
      "Edit(.claude/settings.json)",
      "Write(.claude/settings.json)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/pretool-core-tel.sh"
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/pretool-ajan-fren.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
   {
    "hooks": [
     {
      "type": "command",
      "command": "bash .claude/hooks/userprompt-dosya.sh"
     }
    ]
   }
  ],
  "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/session-start.sh"
          }
        ]
      }
    ]
  }
}
