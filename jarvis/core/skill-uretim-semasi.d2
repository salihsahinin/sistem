title: |md
  # Skill-Üretim Kapı-Ağacı v1 (2026-08-15, deneysel m.29)
  Kabul yürüyüşü = tek yol (UNIQUE) · tür = yol + faset-demeti · 4 kapı + yaprak · her katman ≤5 düğüm
| {near: top-center}

aday: {
  label: "ADAY a\n(ad · amaç · tetik-kalıbı · taslak/tarif)\nköken: aşağıdan (m.43 sayaç) ∨ yukarıdan (Salih emri)"
  shape: oval
}

K0: {
  label: "K0 GEREK (kök · eleme · AND-üstü-OR)\n¬kapsanmış(a,H) ∧ (Y1 ∨ Y2 ∨ Y3)"
  style.fill: "#fff3cd"
  Y1: "Y1 baseline-boşluk\nskill'siz koşumda DRFR ≥1 ✗ ∨ 2 koşum tutarsız"
  Y2: "Y2 kanon-kuralı\n∃ kural∈LAZY gerekli(a,kural)"
  Y3: "Y3 araç-zinciri\n|adım| ≥ 3 ∧ sıra sabit"
}
RET0: {label: "RET-0\naday değil (kutuya girmez)"; shape: rectangle; style.fill: "#f8d7da"}

K1: {
  label: "K1 DEĞER (sayım · OR = \"Y ∨ Z\")\nZ1 ∨ Z2"
  style.fill: "#fff3cd"
  Z1: "Z1 aşağıdan-veri\nk_W ≥ k_τ ∧ (Δ̂ ? ∨ k_W·Δ̂ ≥ (1+β)·C_inşa)\nk_τ=⌈(2τ−1)/(1−τ)⌉, τ=0,8 ⇒ 3 · W=90g · β=0,25"
  Z2: "Z2 yukarıdan-ihtiyaç\nKatman-1 emir (Salih)\nbütçe atlanır, K2/K3 atlanmaz"
}
BEKLET: {label: "BEKLET\nkutu satırı + sayaç işler\nzayıf-yeni → Z2 (Salih onayı)"; shape: rectangle; style.fill: "#e2e3e5"}

INSA: {
  label: "İNŞA (eval-önce, K-016)\n≥3 eval → skill'siz baseline → minimal gövde"
  shape: rectangle
  style.stroke-dash: 3
}

K2: {
  label: "K2 TOPRAKLAMA (eleme · AND · hallucination-freni)\nR ∧ İ ∧ ¬P"
  style.fill: "#fff3cd"
  R: "R referans-varlığı (script)\n∀ r∈ref(a): var(r)\nyol · m.NN · skill adı · araç"
  I: "İ iddia-topraklama (bağımsız doğrulayıcı, CoVe-Factored)\n∀ c∈sayısal ∪ örneklem(n_val): kaynak ∧ TUTUYOR\nn_val = min(|iddia|, max(3,⌈|iddia|/2⌉))"
  P: "¬P prompt-kapısı yasağı\nkapı(a) ⊆ {script, kaynak-denetimi, eval, dış-kayıt}"
}
ONAR2: {label: "ONAR-2\neksik referans/iddia listesi\n≤3 tur → BEKLET"; shape: rectangle; style.fill: "#e2e3e5"}

K3: {
  label: "K3 BİÇİM + TÜR (çatal FIRST + eleme AND)"
  style.fill: "#fff3cd"
  sekil: {
    label: "ŞEKİL (FIRST: T-R > T-O > T-Y > T-Ü; ikisi eşit → BÖL)"
    TR: "T-R RİTÜEL\ntetik ∈ {oturum-sınırı, olay}"
    TO: "T-O ORKESTRATÖR\nçağırır ≥2 skill ∨ alt-ajan"
    TY: "T-Y YAN-ETKİLİ\nkanon-yazım ∨ commit ∨ push ∨ publish"
    TU: "T-Ü ÜRETİCİ\naksi (rapor/öneri/çeviri)"
  }
  bicim: {
    label: "BİÇİM (AND)"
    F1: "F1 description: NE+NE ZAMAN+NEGATİF ∧ 3.şahıs ∧ ≤1024\n∧ Σ_H desc ≤ 0,9×liste-bütçesi"
    F2: "F2 gövde <500 satır ∧ referans ≤1 seviye"
    F3: "F3 evals ≥3 ∧ should/should-not ≥5+5"
    F4: "F4 numaralı adımlar ∧ Gotchas"
    F5: "F5 tek sorumluluk (hakem)"
  }
  turozel: {
    label: "TÜR-ÖZEL"
    y: "T-Y: disable-model-invocation:true ∧ script/plan-validate-execute ∧ m.31"
    o: "T-O: paralellik-uygunluk ∧ handoff kontratı ∧ yürütme-yeri"
    r: "T-R: zaman-kayması freni ∧ klasör-ayrımı ∧ staj negatif-tetiği"
    u: "T-Ü: commit-yapmaz ∧ çıktı disiplini (D/K/X ∨ zarf)"
  }
}
ONAR3: {label: "ONAR-3\neksik alan listesi"; shape: rectangle; style.fill: "#e2e3e5"}

yaprak: {
  label: "YAPRAKLAR (kabul + tür) × {yeni | evrim(s)} + faset-demeti"
  style.fill: "#d4edda"
  UR: "ÜRET-R\nritüel"
  UO: "ÜRET-O\norkestratör"
  UY: "ÜRET-Y\nyan-etkili (elle-tetik)"
  UU: "ÜRET-Ü\nüretici"
}

BAKIM: {
  label: "BAKIM (ağaç-dışı düzeltme kapısı)\nkullanım(son W) < λ=max(1,½·log10 N) → EMEKLİ-ADAY (arşiv, m.8 silme yok)\nilk pencerede k·Δ < (1+β)·C_inşa → EMEKLİ-ADAY · platform eşikleri sürüm-damgalı"
  shape: rectangle
  style.stroke-dash: 3
}

