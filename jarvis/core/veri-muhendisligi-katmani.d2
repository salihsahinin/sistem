# Veri-Mühendisliği Katmanı v1 — D2 graf (core/veri-muhendisligi-katmani.md; deneysel m.29)
# Derleme: d2 core/veri-muhendisligi-katmani.d2 çıktı.svg
# İlke: katman = KOŞUL, ad değil [AB-YT1]; ayrım ekseni = konformans yönü [AB-YT3]; oran ithal edilmez, ölçülür [AB-YT4]

direction: right

bronz: {
  label: "BRONZ — kaynak-konform\ngit-izlenen md/jsonl/json + koşum kütükleri\nyüklem: git-izlenen ∧ append/immutable ∧ ham ∧ provenans=commit SHA\n[AB-YT1, A2-3: git=bronz md için; DVC/Dolt gerekçesiz]"
  style.fill: "#e8f0e8"
}

silver: {
  label: "SİLVER — staging/conformed (veri/baglam.sqlite)\ndosya · kayit · referans · anahtar · json_kayit · karar_borcu(+kaynak)\nyüklem: 1:1 grain ∧ tipli ∧ tekil ∧ null-politikası ∧ AGREGE-OLMAYAN ∧ türetilmiş(2 damga) ∧ test PASS ∧ sözleşme PASS\nYASAK: join/agregasyon (istisna: simetrik union 'base')\n[AB-YT1/YT2/YT5, A1-3, B3-1]"
  style.fill: "#e8ecf4"
  metin: "kayit.metin = bronz kopyası (8,2 MB)\nölçüm şartı: k=3 sonra COST tabanıyla karar"
}

gold: {
  label: "GOLD — iş-konform\nveri/gorunum/*.csv + v_* görünümler + ölçüm-bankı\nyüklem: her metrik TEK yerde (SQL/YAML git'te) ∧ iş-sorusu ∧ silver'a geri-eşlenebilir ∧ sözleşmeli\nGİRMEZ: metrik-katmanı aracı (MetricFlow vb.)\n[AB-YT8, A4-1; gold kazancı ÖLÇÜMSÜZ — kör]"
  style.fill: "#f4efe0"
}

bronz -> silver: "tools/baglam-tablo.py · karar-borcu-tablo.py\n(deterministik; kod SHA + girdi SHA)"
silver -> gold: "SQL view / CSV dökümü\n(agregasyon YALNIZ burada)"

sozlesme: {
  label: "SÖZLEŞMELER (git'te)\nşekil: veri/sozlesme/<tablo>.json (kolon+tip; additive-only;\nkırıcı = silme/tip/kısıt/yeniden-ad) [AB-YT6, A3-2]\niçerik: unique · not_null · accepted_values · relationships + tekil SQL [CD-YT2]\nfreshness: warn_after/error_after; girdi-SHA≠HEAD → WARN [CD-YT1]"
  style.fill: "#f8f0f0"
}

olcum: {
  label: "tools/katman-olcum.py (stdlib)\n→ veri/katman-olcum.jsonl (APPEND-ONLY; 1 satır = 1 ölçüm olgusu)\nvolume · oran(silver/bronz, gold/bronz) · test-pass · sözleşme preflight · freshness\nçıkış 3/4/5 FAIL-LOUD · k=3 koşumda oran-eşiği önerisi [AB-YT4]"
  style.fill: "#eef4ee"
}
sozlesme -> olcum: "zorlayıcı = kendi preflight'ımız\n(dbt contracts ithal edilemez)"
olcum -> silver: "test/sözleşme sonucu (yazma değil, hüküm)"
olcum -> gold: "freshness"
olcum -> bronz: "freshness (git HEAD yaşı)"

amac: {
  label: "İKİ AMAÇ AYRI ÖLÇÜLÜR [§1.3]"
  sistem: "SİSTEM-DEĞERİ\nCOST tabanı: grep+SQLite tek-thread taban çizgisini\ngeçmeyen katman/araç EKLENMEZ [CD-YT6]\nkatalog-önce: ilk getiri anahtar-kaydı erişimi [CD-YT7]"
  ogrenme: "ÖĞRENME-DEĞERİ\nveri/yetkinlik-haritasi.jsonl (DEA-C01 conformed boyut, KALEM granül;\nservis-adlı ↔ kavram/beceri; domain-% hesaplanmaz) [CD-YT3]\nveri/de-pratik.jsonl (pratik birimi = geri-bildirim sinyalli) [CD-YT4]\ntransfer varsayılmaz — ortak_oge yazılır [CD-YT5]"
  kural: "'yavaş ama öğretici yol' karar kuralı: KANITSIZ → Salih (Katman-1 S1)"
}
olcum -> amac.sistem: "ölçüm satırları"
amac.ogrenme -> gold: "yetkinlik/pratik tabloları da gold görünüm"

surec: {
  label: "SÜREÇ KURALI (deneysel; DataOps kazancı ölçümsüz)\nher ship adımı ≥1: (a) silver tablo/sözleşme · (b) gold görünüm/metrik ·\n(c) test/freshness kuralı · (d) katman-olcum koşumu\nkarşılamayan = 'DE-artefaktsız' sayaç (yasak değil); 3 vardiyada yük ölçülür"
  style.fill: "#f4f4f4"
}
surec -> olcum
surec -> amac.ogrenme: "seans-kapanis hasadına de-pratik satırı (skill evrimi)"

arac: {
  label: "ARAÇ KARARI v1 — stdlib-önce\nSQLite tek motor · DuckDB GİRMEZ (yorumlayıcı ≥3.10 + stdlib sapması; ATTACH kolonsal kazanç vermez)\ndbt/sqlmesh/dlt/orkestratör GİRMEZ (eşik [ARANAMADI]) · git=sürümleme; DVC/lakeFS/Dolt yalnız satır-diff ihtiyacı ölçülürse\nyeniden-değerlendirme tetiği = ÖLÇÜLMÜŞ süre/bellek [AB-YT7, B4-2, AB-YT5]"
  style.fill: "#f0f0f8"
}
arac -> silver
