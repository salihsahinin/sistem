{
  "_not": "Alan ajanı ayarı (Karar 105, 2026-09-21; target/release/alan-ajani-dogur sablonlar/ajan-iskelet/claude-ayar/ → .claude/ kopyalar). Okuma kilidi hook'ta; deny = yazma ve push frenleri.",
  "permissions": {
    "deny": [
      "Read(//c/sistem/sistem/jarvis/**)",
      "Read(//c/sistem/sistem/friday/**)",
      "Edit(//c/sistem/sistem/ogrenme/**)",
      "Edit(//c/sistem/sistem/sablonlar/**)",
      "Bash(git push origin main:*)",
      "Bash(git push origin HEAD:main:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git add -A:*)",
      "Bash(git add .:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {"matcher": "Read|Grep|Glob|Bash", "hooks": [{"type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/okuma-izin.sh\""}]}
    ],
    "PostToolUse": [
      {"hooks": [{"type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/hareket-kutuk.sh\""}]}
    ]
  }
}
