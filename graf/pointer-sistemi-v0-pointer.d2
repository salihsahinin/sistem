  etiket: "etiket" { class: dis }
  git: "git" { class: dis }
  url: "url" { class: dis }
  zaman: "zaman" { class: dis }
}
anahtar -> anahtar: "replaced_by = prov:wasRevisionOf (süpersede, SCD-2)" { class: supersede }
pointer.anahtar_terim -> anahtar.anahtar_terim: "terim → anahtar kaydı" { class: fk }
pointer.dosya_pointer -> dosya: "yol → dosya (hedef_var ile çözümlü/kırık)" { class: kirik }
pointer.etiket -> dis.etiket: "#etiket (serbest sınıflandırma)" { class: fk }
pointer.kart -> anahtar.kart: "K-NNN → pano kartı (anahtar kaydı)" { class: fk }
pointer.sha -> dis.git: "git commit/blob (provenans)" { class: fk }
pointer.skill_adi -> anahtar.skill: "skill adı → hazine" { class: fk }
pointer.tarih -> dis.zaman: "zaman damgası (as-of)" { class: fk }
pointer.tuzuk_madde -> anahtar.tuzuk_madde: "m.N → tüzük maddesi (anahtar kaydı)" { class: fk }
pointer.url -> dis.url: "dış kaynak (repo dışı)" { class: fk }
pointer.v_no -> anahtar.v_no: "V-n → kural/öneri numarası (anahtar kaydı)" { class: fk }
pointer.wiki_link -> anahtar.wiki_sayfa: "[[sayfa]] → wiki sayfası (anahtar kaydı)" { class: fk }
