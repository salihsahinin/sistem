# Jarvis POINTER SİSTEMİ — POINTER TÜRLERİ → ÇÖZÜMLEME HEDEFLERİ (pano 2/4) (türetilmiş görünüm; ham kaynak silver/bronz)
# üretici: tools/pointer-graf.py · silver c5a1ebe · HEAD c5a1ebe · d2 v0.8.1-HEAD · render: d2 --layout=elk (ELK bundled; TALA girmez; determinizm yerel sha256 ile ölçülür — Karar 65)
# içerik katmanı: düğüm/kenar = silver'dan script türetimi (LLM yazmaz); ilke/kronoloji = kanon SABİTİ (pointer'lı, script içinde); yorum katmanı = bu # satırları
direction: right
classes: {
  kutu: { style: { fill: "#F4F4F4"; stroke: "#444444"; font-size: 16; border-radius: 6 } }
  pointer: { style: { fill: "#E8F0FE"; stroke: "#1A56DB"; border-radius: 6 } }
  anahtar: { style: { fill: "#FFF4E5"; stroke: "#B45309"; border-radius: 6 } }
  hat: { style: { fill: "#ECFDF5"; stroke: "#047857"; bold: true; border-radius: 6 } }
  ilke: { shape: hexagon; style: { fill: "#FDF2F8"; stroke: "#9D174D" } }
  kron: { shape: page; style: { fill: "#FFFFFF"; stroke: "#6B7280" } }
  dis: { shape: cloud; style: { fill: "#FAFAFA"; stroke: "#9CA3AF" } }
  kirik: { style: { stroke: "#DC2626"; stroke-dash: 3; font-size: 14 } }
  supersede: { style: { stroke: "#B45309"; stroke-dash: 5 } }
  fk: { style: { stroke: "#444444"; font-size: 14 } }
  turetir: { style: { stroke: "#047857"; stroke-width: 3 } }
  uygular: { style: { stroke: "#9D174D"; stroke-dash: 2; font-size: 14 } }
}
pointer: "REFERANS TÜRLERİ (referans.ref_turu)" {
  anahtar_terim: "anahtar_terim · 33.761" { class: pointer }
  dosya_pointer: "dosya_pointer · 12.001\n10.501 çözümlü / 1.500 KIRIK" { class: pointer }
  etiket: "etiket · 5.660" { class: pointer }
  kart: "kart · 2.148" { class: pointer }
  sha: "sha · 1.243" { class: pointer }
  skill_adi: "skill_adi · 1.870" { class: pointer }
  tarih: "tarih · 4.112" { class: pointer }
  tuzuk_madde: "tuzuk_madde · 8.350" { class: pointer }
  url: "url · 4.866" { class: pointer }
  v_no: "v_no · 3.505" { class: pointer }
  wiki_link: "wiki_link · 317" { class: pointer }
}
anahtar: "ANAHTAR KAYDI (anahtar.tur)" {
  anahtar_terim: "anahtar_terim · 27" { class: anahtar }
  kart: "kart · 23" { class: anahtar }
  skill: "skill · 16" { class: anahtar }
