  sirada: {style.stroke-width: 3; style.stroke: "#e03131"}
}
aciklama: |md
  Kutu = iş · altıgen = hedef · sayfa = seans (sohbet) · kırmızı kalın çerçeve = sırada (girdileri tamam)\
  Renk: sarı açık · turuncu işlemde · yeşil tamam · gri tüketildi · soluk bayat\
  Ok: girdi (bağımlılık) · hizmet (iş→hedef) · açtı/bitirdi (seans→iş) · sonra (seans→seans)
|
