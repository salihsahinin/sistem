{
  "permissions": {
    "deny": [
      "Edit(kanon/**)",
      "Write(kanon/**)",
      "Bash(git push:*)",
      "Bash(git add -A:*)",
      "Bash(git add .:*)",
      "Read(~/jarvis/CLAUDE.md)",
      "Read(~/jarvis/KILAVUZ.md)",
      "Read(~/jarvis/README.md)",
      "Read(~/jarvis/fikir-kutusu.md)",
      "Read(~/jarvis/kuyruk/**)",
      "Read(~/jarvis/raporlar/**)",
      "Read(~/jarvis/cc/**)",
      "Read(~/jarvis/wiki/**)",
      "Read(~/jarvis/veri/**)",
      "Read(~/jarvis/tools/**)",
      "Read(~/jarvis/.claude/**)",
      "Read(~/jarvis/kaynak-kodu/**)",
      "Read(~/jarvis/ogrenme/**)",
      "Read(~/jarvis/arsiv/**)",
      "Read(~/jarvis/graf/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Grep|Glob|Bash",
        "hooks": [{"type": "command", "command": "bash .claude/hooks/okuma-izin.sh"}]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [{"type": "command", "command": "bash .claude/hooks/hareket-kutuk.sh"}]
      }
    ]
  }
}
